#!/usr/bin/env bash
# Source from repo root. Local development DB only; never a production target.
if ! test -f .commons/db-password; then
  if test -e .commons/pgdata/PG_VERSION; then
    echo 'Existing cluster has no local password file; refusing credential replacement.' >&2
    return 1
  fi
  umask 077
  mkdir -p .commons
  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > .commons/db-password
fi
export DATABASE_URL="postgres://commons:$(cat .commons/db-password)@127.0.0.1:55432/commons"

# Check the authenticated server's actual directory, not merely a loopback URL.
# Shared by explicit init and ordinary serve; neither may adopt a neighboring cluster.
commons_dev_check_database() {
  local actual expected
  expected="$(realpath .commons/pgdata)" || return 1
  actual="$(PGPASSWORD="$(cat .commons/db-password)" psql -X -h 127.0.0.1 -p 55432 -U commons -d postgres -Atc 'SHOW data_directory')" || return 1
  if test "$actual" != "$expected"; then
    echo 'Refusing PostgreSQL outside this checkout .commons/pgdata.' >&2
    return 1
  fi
}
