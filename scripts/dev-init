#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/dev-env
# Explicit, repeatable migration; creates a database only if absent.
# A supervised restart can return before PostgreSQL accepts connections.
for attempt in $(seq 1 100); do
  pg_isready -h 127.0.0.1 -p 55432 -q && break
  if test "$attempt" = 100; then
    echo 'Native PostgreSQL did not become ready; inspect commons-db service logs.' >&2
    exit 1
  fi
  sleep 0.1
done
commons_dev_check_database
export PGPASSWORD="$(cat .commons/db-password)"
exists="$(psql -X -v ON_ERROR_STOP=1 -h 127.0.0.1 -p 55432 -U commons -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='commons'")"
if test "$exists" != 1; then
  createdb -h 127.0.0.1 -p 55432 -U commons commons
fi
target/debug/commons migrate
